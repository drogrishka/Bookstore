@model Bookstore.Api.Models.Account.LoginViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bookstore sign in</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f4f6f8; margin: 0; }
        main { max-width: 420px; margin: 10vh auto; background: white; padding: 2rem; border-radius: 14px;
               box-shadow: 0 10px 35px rgba(0,0,0,.08); }
        label { display:block; margin:.9rem 0 .35rem; font-weight:600; }
        input { width:100%; box-sizing:border-box; padding:.75rem; border:1px solid #cbd5e1; border-radius:8px; }
        button { width:100%; margin-top:1.2rem; padding:.8rem; border:0; border-radius:8px; background:#111827;
                 color:white; font-weight:700; cursor:pointer; }
        .validation-summary-errors { color:#b91c1c; }
        .hint { color:#475569; font-size:.92rem; }
    </style>
</head>
<body>
<main>
    <h1>Bookstore</h1>
    <p>Sign in to obtain an implicit-flow search access token.</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" />
        <span asp-validation-for="Email"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
        <button type="submit">Sign in</button>
    </form>
    <p class="hint">Development demo: demo@bookstore.local / Demo123!</p>
</main>
</body>
</html>
